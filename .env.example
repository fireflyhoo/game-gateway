# 服务监听
HOST=0.0.0.0
PORT=8080

# ★ 生产环境务必改成高强度随机串，例如：openssl rand -hex 32
#   自定义后，dev-token 接口会自动关闭，必须由你的业务服务签发 JWT
JWT_SECRET=dev-only-secret-please-change-in-production
JWT_TTL_SECS=7200

# 房间默认上限（创建房间时可被覆盖，范围 2~64）
MAX_PLAYERS_DEFAULT=8

# 同一身份允许的最大并发 WS 连接数（防多开）
MAX_CONNECTIONS_PER_IDENTITY=4

# WS 空闲超时（秒），期间无任何消息则断开
WS_IDLE_TIMEOUT_SECS=120

# 日志级别
RUST_LOG=info
