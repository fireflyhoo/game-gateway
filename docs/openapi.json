{
  "openapi": "3.1.0",
  "info": {
    "title": "game-gateway API",
    "version": "0.1.0",
    "description": "Web 联机游戏通用后端。REST 部分遵循本 OpenAPI 规范；WebSocket 部分见 /ai/manifest.json 与 /ai/guide。服务自描述端点见 / 与 /llms.txt。",
    "x-websocket": {
      "endpoint": "/ws?token={jwt}",
      "manifest": "/ai/manifest.json",
      "guide": "/ai/guide",
      "moderation": "房主可发 room_kick/room_ban/room_unban (payload: {target}) 踢人/封禁/解封；加密码房间用 room_join {room, password}。详见 manifest.websocket.client_messages"
    }
  },
  "servers": [{ "url": "{{BASE_URL}}", "description": "当前实例" }],
  "tags": [
    { "name": "system", "description": "健康检查与服务信息" },
    { "name": "discovery", "description": "AI 自描述文档端点" },
    { "name": "auth", "description": "鉴权" },
    { "name": "rooms", "description": "房间管理" },
    { "name": "players", "description": "在线玩家" }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["discovery"],
        "summary": "根发现文档",
        "description": "列出本服务所有自描述资源。AI 建议从此或 /api/v1/info 开始。",
        "responses": { "200": { "description": "发现文档", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Discovery" } } } } }
      }
    },
    "/health": {
      "get": {
        "tags": ["system"],
        "summary": "健康检查",
        "responses": { "200": { "description": "healthy", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } } }
      }
    },
    "/api/v1/info": {
      "get": {
        "tags": ["system", "discovery"],
        "summary": "服务信息、统计与发现指针",
        "responses": { "200": { "description": "服务信息", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Info" } } } } }
      }
    },
    "/llms.txt": {
      "get": { "tags": ["discovery"], "summary": "llmstxt.org 约定的 AI 入口清单", "responses": { "200": { "description": "纯文本", "content": { "text/plain": { "schema": { "type": "string" } } } } } }
    },
    "/ai/manifest.json": {
      "get": { "tags": ["discovery"], "summary": "完整机器可读能力清单", "responses": { "200": { "description": "JSON", "content": { "application/json": { "schema": { "type": "object" } } } } } }
    },
    "/ai/openapi.json": {
      "get": { "tags": ["discovery"], "summary": "本 OpenAPI 规范", "responses": { "200": { "description": "JSON", "content": { "application/json": { "schema": { "type": "object" } } } } } }
    },
    "/ai/capabilities": {
      "get": { "tags": ["discovery"], "summary": "当前实例的实际配置与开关状态", "responses": { "200": { "description": "JSON", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Capabilities" } } } } } }
    },
    "/ai/guide": {
      "get": { "tags": ["discovery"], "summary": "完整接入指南（Markdown）", "responses": { "200": { "description": "Markdown", "content": { "text/markdown": { "schema": { "type": "string" } } } } } }
    },
    "/api/v1/auth/dev-token": {
      "post": {
        "tags": ["auth"],
        "summary": "签发联调 token（仅默认 JWT_SECRET 时可用）",
        "description": "自定义 JWT_SECRET 后返回 403。生产应由业务服务签发 JWT。",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DevTokenReq" } } } },
        "responses": {
          "200": { "description": "签发的 token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DevTokenResp" } } } },
          "400": { "description": "identity 为空", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "dev-token 已关闭", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/v1/rooms": {
      "get": {
        "tags": ["rooms"],
        "summary": "列出房间",
        "parameters": [
          { "name": "game", "in": "query", "required": false, "schema": { "type": "string" }, "description": "按游戏标识过滤" },
          { "name": "visibility", "in": "query", "required": false, "schema": { "type": "string", "enum": ["public", "private"] } }
        ],
        "responses": { "200": { "description": "房间列表", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoomList" } } } } }
      },
      "post": {
        "tags": ["rooms"],
        "summary": "创建房间",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateRoomReq" } } } },
        "responses": {
          "200": { "description": "创建的房间", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoomResp" } } } },
          "400": { "description": "参数非法或 game 不一致", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "未认证", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/v1/rooms/{room_id}": {
      "get": {
        "tags": ["rooms"],
        "summary": "查询房间详情",
        "parameters": [{ "name": "room_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "房间详情", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoomResp" } } } },
          "404": { "description": "房间不存在", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "delete": {
        "tags": ["rooms"],
        "summary": "解散房间（仅房主）",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "room_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "已解散", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "dissolved": { "type": "string" } } } } } },
          "401": { "description": "未认证", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "房间不存在", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "非房主", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/v1/players": {
      "get": {
        "tags": ["players"],
        "summary": "在线玩家（identity -> nick）",
        "parameters": [{ "name": "game", "in": "query", "required": false, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "在线玩家", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlayerList" } } } } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT HS256", "description": "JWT 由业务方用同一 JWT_SECRET 签发。claim: sub/nick/game/iat/exp" }
    },
    "schemas": {
      "Discovery": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "service": { "type": "string" },
          "version": { "type": "string" },
          "description": { "type": "string" },
          "start_here": { "type": "array", "items": { "type": "string" } },
          "resources": { "type": "array", "items": { "$ref": "#/components/schemas/DocResource" } }
        }
      },
      "DocResource": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "format": { "type": "string" },
          "desc": { "type": "string" }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "status": { "type": "string", "enum": ["healthy"] },
          "time": { "type": "string", "format": "date-time" }
        }
      },
      "Info": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "service": { "type": "string" },
          "version": { "type": "string" },
          "stats": { "type": "object", "properties": { "rooms": { "type": "integer" }, "connections": { "type": "integer" }, "online_identities": { "type": "integer" } } },
          "limits": { "type": "object", "properties": { "max_players_default": { "type": "integer" }, "ws_idle_timeout_secs": { "type": "integer" } } },
          "discovery": { "type": "object", "properties": { "docs": { "type": "array", "items": { "$ref": "#/components/schemas/DocResource" } } } }
        }
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "service": { "type": "string" },
          "version": { "type": "string" },
          "runtime": { "type": "object" },
          "features": { "type": "object" },
          "limits": { "type": "object" },
          "discovery": { "type": "object" }
        }
      },
      "DevTokenReq": {
        "type": "object",
        "required": ["identity"],
        "properties": {
          "identity": { "type": "string" },
          "nick": { "type": "string", "default": "" },
          "game": { "type": "string", "default": "default" }
        }
      },
      "DevTokenResp": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "token": { "type": "string" },
          "token_type": { "type": "string", "enum": ["Bearer"] },
          "expires_in": { "type": "integer" },
          "identity": { "type": "string" },
          "game": { "type": "string" }
        }
      },
      "CreateRoomReq": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "game": { "type": "string", "default": "default", "maxLength": 64, "description": "必须等于 JWT 的 game claim" },
          "visibility": { "type": "string", "enum": ["public", "private"], "default": "public" },
          "max_players": { "type": "integer", "minimum": 2, "maximum": 64, "default": 8 },
          "metadata": { "type": "object", "default": {} },
          "password": { "type": "string", "description": "加入密码（可选）。仅存加盐哈希；Room 响应只含 has_password，绝不泄露密码" }
        }
      },
      "Seat": {
        "type": "object",
        "properties": {
          "identity": { "type": "string" },
          "nick": { "type": "string" },
          "ready": { "type": "boolean" },
          "is_host": { "type": "boolean" },
          "connected": { "type": "boolean" }
        }
      },
      "Room": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "game": { "type": "string" },
          "name": { "type": "string" },
          "visibility": { "type": "string", "enum": ["public", "private"] },
          "state": { "type": "string", "enum": ["waiting", "playing", "finished"] },
          "max_players": { "type": "integer" },
          "host": { "type": "string" },
          "metadata": { "type": "object" },
          "seats": { "type": "array", "items": { "$ref": "#/components/schemas/Seat" } },
          "created_at": { "type": "string", "format": "date-time" },
          "has_password": { "type": "boolean", "description": "是否设置了加入密码（密码本身永不返回）" }
        }
      },
      "RoomResp": {
        "type": "object",
        "properties": { "ok": { "type": "boolean" }, "room": { "$ref": "#/components/schemas/Room" } }
      },
      "RoomList": {
        "type": "object",
        "properties": { "ok": { "type": "boolean" }, "rooms": { "type": "array", "items": { "$ref": "#/components/schemas/Room" } }, "count": { "type": "integer" } }
      },
      "PlayerList": {
        "type": "object",
        "properties": { "ok": { "type": "boolean" }, "players": { "type": "object", "additionalProperties": { "type": "string" } }, "count": { "type": "integer" } }
      },
      "Error": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "enum": [false] },
          "error": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" } } }
        }
      }
    }
  }
}
